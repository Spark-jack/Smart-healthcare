# Database Configuration (PostgreSQL default or SQLite for zero-setup local dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_health
# DATABASE_URL=sqlite:///./healthcare.db

# JWT Security
# MANDATORY: Generate a cryptographically secure key with: python scripts/generate_secret.py
# If missing or shorter than 32 characters, the application will refuse to start.
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY_MIN_32_CHARACTERS_LONG
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Email / Notification SMTP Configuration (Optional)
# If unconfigured, notifications are logged to the console and stored in the EmailOutbox table.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@smarthealth.local
ENABLE_SCHEDULER=true

# Environment
ENVIRONMENT=development
PORT=8000
